<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContentDisplay?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox prefWidth="220.0" spacing="15.0" styleClass="sidebar" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.java_music_playlist_manager.SidebarController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="20.0" />
   </padding>
   <children>
      <!-- Titolo Applicazione -->
      <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Lettore musicale" />
      
      <!-- Barra di Ricerca -->
      <TextField fx:id="searchField" promptText="Cerca" />
      
      <!-- Pulsanti Principali Sidebar -->
      <VBox spacing="8.0" VBox.vgrow="ALWAYS">
         <children>
            <Button fx:id="homeButton" styleClass="sidebar-button" alignment="BASELINE_LEFT" contentDisplay="LEFT" maxWidth="Infinity" onAction="#handleHomeAction" text="  Home">
               <graphic><FontIcon styleClass="sidebar-icon" iconLiteral="fas-home" /></graphic>
            </Button>
            <Button fx:id="musicLibraryButton" styleClass="sidebar-button" alignment="BASELINE_LEFT" contentDisplay="LEFT" maxWidth="Infinity" onAction="#handleMusicLibraryAction" text="  Libreria musicale">
               <graphic><FontIcon styleClass="sidebar-icon" iconLiteral="fas-music" /></graphic>
            </Button>
            <Button fx:id="playQueueButton" styleClass="sidebar-button" alignment="BASELINE_LEFT" contentDisplay="LEFT" maxWidth="Infinity" onAction="#handlePlayQueueAction" text="  Coda di riproduzione">
               <graphic><FontIcon styleClass="sidebar-icon" iconLiteral="fas-list" /></graphic>
            </Button>
            <Button fx:id="playlistButton" styleClass="sidebar-button" alignment="BASELINE_LEFT" contentDisplay="LEFT" maxWidth="Infinity" onAction="#handlePlaylistAction" text="  Playlist">
               <graphic><FontIcon styleClass="sidebar-icon" iconLiteral="fas-layer-group" /></graphic>
            </Button>
         </children>
      </VBox>

      <!-- Spaziatore per spingere il pulsante tema in fondo -->
      <Region VBox.vgrow="ALWAYS" />

      <!-- Pulsante selezione tema -->
      <Button fx:id="themeButton" styleClass="sidebar-button" contentDisplay="LEFT" maxWidth="Infinity" onAction="#handleThemeAction" text="  Tema">
         <graphic><FontIcon styleClass="sidebar-icon" iconLiteral="fas-palette" /></graphic>
      </Button>
   </children>
</VBox>
