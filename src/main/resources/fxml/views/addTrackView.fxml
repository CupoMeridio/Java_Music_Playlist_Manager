<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import org.controlsfx.control.CheckComboBox?>

<!--
    View secondaria per l'inserimento o la modifica di un brano.

    Collegata al controller AddTrackController, che gestisce
    la logica del form di inserimento e modifica brani.
-->

<VBox fillWidth="true" maxHeight="Infinity" maxWidth="Infinity" prefHeight="392.0" prefWidth="319.0" spacing="15.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.java_music_playlist_manager.AddTrackController">

    <!-- Margini interni della finestra -->
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <children>

        <!-- Titolo del form -->
        <Label fx:id="formTitleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Aggiungi nuovo brano" />

        <!--
            GridPane usato per disporre etichette e campi di input.

            La seconda colonna ha hgrow="ALWAYS":
            questo permette ai TextField di espandersi quando la finestra
            viene allargata orizzontalmente.
        -->
        <GridPane accessibleText="Tag" hgap="12.0" maxWidth="Infinity" vgap="12.0">

            <columnConstraints>
                <!-- Colonna delle etichette: larghezza quasi fissa -->
                <ColumnConstraints minWidth="80.0" prefWidth="90.0" />

                <!-- Colonna dei campi input: si espande con la finestra -->
                <ColumnConstraints fillWidth="true" hgrow="ALWAYS" />
            </columnConstraints>

            <children>
                <Label text="Titolo:" GridPane.columnIndex="0" />

                <TextField fx:id="addTrackTitleField" maxWidth="Infinity" GridPane.columnIndex="1" />

                <Label text="Autore:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                <TextField fx:id="addTrackAuthorField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Durata:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

                <TextField fx:id="addTrackDurationField" maxWidth="Infinity" promptText="Secondi" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Genere:" GridPane.columnIndex="0" GridPane.rowIndex="3" />

                <ComboBox fx:id="addTrackGenreComboBox" maxWidth="Infinity" promptText="Seleziona genere" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Anno:" GridPane.columnIndex="0" GridPane.rowIndex="4" />

                <TextField fx:id="addTrackYearField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label text="Tag" GridPane.rowIndex="5" />
            <CheckComboBox fx:id="addTrackTagComboBox" maxWidth="1.7976931348623157E308" title="Seleziona Tags" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints minHeight="10.0" prefHeight="30.0" />
         </rowConstraints>
        </GridPane>

        <!--
            Label per mostrare eventuali errori di validazione.
            Il testo viene impostato dal PrimaryViewController.
        -->
        <Label fx:id="addTrackErrorLabel" style="-fx-text-fill: red;" text="" />

        <!--
            Spaziatore verticale.
            Se la finestra viene allungata in altezza, questo Region occupa
            lo spazio libero e mantiene i bottoni nella parte bassa.
        -->
        <Region VBox.vgrow="ALWAYS" />

        <!-- Pulsanti finali del form -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <!--
                    Pulsanti del form: Salva aggiunge il brano alla Library o lo modifica,
                    Annulla chiude la finestra. L'aggiornamento della tabella
                    principale sarà integrato nella fase di collegamento con la View.
                -->
                <Button onAction="#handleSaveTrack" text="Salva" />
                <Button onAction="#handleCancelAddTrack" text="Annulla" />
            </children>
        </HBox>

    </children>
</VBox>
