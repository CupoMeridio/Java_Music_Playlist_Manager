<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Schermata principale Home con le statistiche di riproduzione.
    Collegata al controller HomeController.
-->

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.java_music_playlist_manager.HomeController">

   <content>
      <VBox spacing="18.0">

         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>

      <!-- RIGA STATISTICHE RAPIDE -->
      <HBox spacing="16.0">
         <children>

            <!-- Card: Totale brani -->
            <VBox fx:id="cardTotalTracks" spacing="6.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-padding: 20 24;">
               <children>
                  <Label text="Brani in libreria" />
                  <Label fx:id="totalTracksLabel" text="0" />
               </children>
            </VBox>

            <!-- Card: Totale playlist -->
            <VBox fx:id="cardTotalPlaylists" spacing="6.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-padding: 20 24;">
               <children>
                  <Label text="Playlist create" />
                  <Label fx:id="totalPlaylistsLabel" text="0" />
               </children>
            </VBox>

            <!-- Card: Brani riprodotti -->
            <VBox fx:id="cardTotalPlays" spacing="6.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-padding: 20 24;">
               <children>
                  <Label text="Riproduzioni totali" />
                  <Label fx:id="totalPlaysLabel" text="0" />
               </children>
            </VBox>

         </children>
      </HBox>

      <!-- SEZIONE BRANI PIÙ RIPRODOTTI -->
      <VBox spacing="10.0">
         <children>
            <Label text="Brani più riprodotti" />

            <TableView fx:id="topTracksTable" prefHeight="240.0">
               <columns>
                  <TableColumn fx:id="topTrackRankColumn" prefWidth="45.0" text="#" />
                  <TableColumn fx:id="topTrackTitleColumn" prefWidth="220.0" text="Titolo" />
                  <TableColumn fx:id="topTrackArtistColumn" prefWidth="180.0" text="Artista" />
                  <TableColumn fx:id="topTrackCountColumn" prefWidth="110.0" text="▶ Ascolti" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>

      <!-- SEZIONE PLAYLIST PIÙ RIPRODOTTE -->
      <VBox spacing="10.0">
         <children>
            <Label text="Playlist più riprodotte" />

            <TableView fx:id="topPlayedPlaylistsTable" prefHeight="240.0">
               <columns>
                  <TableColumn fx:id="topPlayedPlaylistRankColumn" prefWidth="45.0" text="#" />
                  <TableColumn fx:id="topPlayedPlaylistNameColumn" prefWidth="250.0" text="Nome Playlist" />
                  <TableColumn fx:id="topPlayedPlaylistPlayCountColumn" prefWidth="120.0" text="▶ Riproduzioni" />
                  <TableColumn fx:id="topPlayedPlaylistTrackCountColumn" prefWidth="100.0" text="Brani" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>

      <!-- SEZIONE PLAYLIST PIÙ POPOLARI -->
      <VBox spacing="10.0">
         <children>
            <Label text="Playlist per numero di brani" />

            <TableView fx:id="topPlaylistsTable" prefHeight="240.0">
               <columns>
                  <TableColumn fx:id="topPlaylistRankColumn" prefWidth="45.0" text="#" />
                  <TableColumn fx:id="topPlaylistNameColumn" prefWidth="250.0" text="Nome Playlist" />
                  <TableColumn fx:id="topPlaylistCountColumn" prefWidth="100.0" text="Brani" />
                  <TableColumn fx:id="topPlaylistDurationColumn" prefWidth="120.0" text="Durata" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>

         </children>
      </VBox>
   </content>
</ScrollPane>
