<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    Barra di riproduzione inferiore dell'applicazione.
    Collegata al controller PlayerController.
-->

<VBox spacing="10.0" styleClass="player-bar"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unisa.java_music_playlist_manager.PlayerController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="10.0" />
   </padding>
   <children>
      <!-- Riga 1: Barra di Progresso (Timeline) con Tempi -->
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Label fx:id="currentTimeLabel" text="00:00:00" />
            <Slider fx:id="progressSlider" HBox.hgrow="ALWAYS" />
            <Label fx:id="totalTimeLabel" text="00:00:00" />
         </children>
      </HBox>
      
      <!-- Riga 2: Dettagli Brano, Controlli Riproduzione, Volume e Opzioni -->
      <HBox alignment="CENTER" spacing="20.0">
         <children>
            
            <!-- Lato Sinistro: Copertina e Info Traccia -->
            <HBox alignment="CENTER_LEFT" prefWidth="250.0" spacing="10.0" HBox.hgrow="NEVER">
               <children>
                  <!-- Copertina del Brano / Vista Vinile (cliccabile per alternare) -->
                  <StackPane fx:id="coverContainer" prefHeight="62.0" prefWidth="62.0" style="-fx-cursor: hand;" onMouseClicked="#handleCoverClick" />
                  
                  <!-- Metadati del Brano (Titolo e Artista) -->
                  <VBox alignment="CENTER_LEFT" spacing="3.0">
                     <children>
                        <Label fx:id="currentTrackTitle" text="" />
                        <Label fx:id="currentTrackDetails" text="" textOverrun="ELLIPSIS" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <!-- Spaziatore a sinistra per centrare i controlli -->
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- Centro: Controlli Riproduzione (Casuale, Indietro, Play/Pausa, Avanti, Ciclo) -->
            <HBox alignment="CENTER" spacing="15.0" HBox.hgrow="NEVER">
               <children>
                  <Button fx:id="shuffleButton" styleClass="player-button" onAction="#handleShuffleToggle">
                     <graphic><FontIcon iconLiteral="fas-random" /></graphic>
                  </Button>
                  <Button fx:id="prevPlayableButton" styleClass="player-button" onAction="#handlePreviousPlayableAction">
                     <graphic><FontIcon iconLiteral="fas-fast-backward" /></graphic>
                  </Button>
                  <Button fx:id="prevButton" styleClass="player-button" onAction="#handlePrevAction">
                     <graphic><FontIcon iconLiteral="fas-step-backward" /></graphic>
                  </Button>
                  <Button fx:id="playPauseButton" styleClass="player-button" onAction="#handlePlayPauseAction">
                     <graphic><FontIcon fx:id="playPauseIcon" iconLiteral="fas-play" /></graphic>
                  </Button>
                  <Button fx:id="nextButton" styleClass="player-button" onAction="#handleNextAction">
                     <graphic><FontIcon iconLiteral="fas-step-forward" /></graphic>
                  </Button>
                  <Button fx:id="nextPlayableButton" styleClass="player-button" onAction="#handleNextPlayableAction">
                     <graphic><FontIcon iconLiteral="fas-fast-forward" /></graphic>
                  </Button>
                  <Button fx:id="repeatButton" styleClass="player-button" onAction="#handleRepeatToggle">
                     <graphic><FontIcon iconLiteral="fas-redo" /></graphic>
                  </Button>
               </children>
            </HBox>
            
            <!-- Spaziatore a destra per spingere il volume a destra -->
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- Lato Destro: Volume -->
            <HBox alignment="CENTER_RIGHT" prefWidth="250.0" spacing="10.0" HBox.hgrow="NEVER">
               <children>
                  <!-- Controllo Volume -->
                  <Button fx:id="volumeButton" styleClass="player-button" onAction="#handleVolumeMuteToggle">
                     <graphic><FontIcon fx:id="volumeIcon" iconLiteral="fas-volume-up" /></graphic>
                  </Button>
                  <Slider fx:id="volumeSlider" max="100.0" prefWidth="100.0" value="50.0" />
               </children>
            </HBox>
            
         </children>
      </HBox>
   </children>
</VBox>
