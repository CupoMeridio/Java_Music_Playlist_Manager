<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.GridView?>

<!-- 
    File FXML generato e gestito tramite SceneBuilder.
    Definisce la struttura dell'interfaccia utente principale.
    Collegato al controller it.unisa.java_music_playlist_manager.PrimaryViewController
-->

<BorderPane minHeight="600.0" minWidth="900.0" prefWidth="1132.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.java_music_playlist_manager.PrimaryViewController">
   
   <!-- 1. BARRA LATERALE (LEFT) -->
   <left>
      <fx:include fx:id="sidebar" source="views/SidebarView.fxml" />
   </left>
   
   <!-- 2. SEZIONE CENTRALE PRINCIPALE (CENTER) -->
   <center>
      <VBox spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <!-- Intestazione Superiore (Titolo e Azioni contestuali) -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <!-- Titolo Sezione Attiva -->
                  <Label fx:id="viewTitleLabel" text="Musica" />
                  
                  <!-- Spaziatore per spingere il bottone a destra -->
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <!-- Bottone d'azione dinamico (Aggiungi brano / Nuova playlist) -->
                  <Button fx:id="actionButton" onAction="#handleActionBtnClick" text="Aggiungi brano" />
                  
                  <!-- Bottone Undo sempre raggiungibile -->
                  <Button fx:id="undoButton" onAction="#handleUndoAction" text="Undo" />
               </children>
            </HBox>
            
            <!-- Barra di Controllo Playlist / Ordinamento -->
            <HBox fx:id="controlsBar" alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Button fx:id="playPlaylistButton" disable="true" onAction="#handlePlayPlaylistAction" text="Riproduci Playlist" />
                  <ToggleButton fx:id="reorderButton" managed="false" text="Riordina" visible="false" />
                  <Region HBox.hgrow="ALWAYS" />
                  <ToggleButton fx:id="viewToggleButton" onAction="#handleViewToggleAction" text="Vista a schede ☷" />
               </children>
            </HBox>
            
            <!-- Tabella per l'elenco dei Brani (TableView) -->
            <!-- NOTA: Le colonne NON vanno definite qui nel FXML.
                 Vengono create dinamicamente dal metodo
                 PrimaryViewController#showSongsColumns() in Java.
                 SceneBuilder tende a ri-aggiungerle automaticamente
                 se si apre questo file: se capita, vanno ri-rimosse. -->
            <TableView fx:id="trackTableView" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
            <!-- Contenitore vista a schede per brani (ControlsFX GridView) -->
            <GridView fx:id="trackCardGridView" VBox.vgrow="ALWAYS" visible="false" managed="false" styleClass="card-grid-view" cellWidth="160" cellHeight="220" horizontalCellSpacing="15" verticalCellSpacing="15" />
            
            <!-- Tabella per l'elenco delle Playlist (TableView) -->
            <TableView fx:id="playlistTableView" VBox.vgrow="ALWAYS" visible="false" managed="false">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
            <!-- Lista per la Coda di Riproduzione (ListView) -->
            <javafx.scene.control.ListView fx:id="queueListView" VBox.vgrow="ALWAYS" visible="false" managed="false" />

            <!-- Pannello Home / Statistiche (nascosto di default) -->
            <fx:include fx:id="homeView" source="views/HomeView.fxml" VBox.vgrow="ALWAYS" visible="false" managed="false" />
         </children>
      </VBox>
   </center>
   
   <!-- 3. BARRA DI RIPRODUZIONE IN BASSO (BOTTOM) -->
   <bottom>
      <fx:include fx:id="playerBar" source="views/PlayerBarView.fxml" />
   </bottom>
   
</BorderPane>
