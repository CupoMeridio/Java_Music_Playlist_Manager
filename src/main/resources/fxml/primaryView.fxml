<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- 
    File FXML generato e gestito tramite SceneBuilder.
    Definisce la struttura dell'interfaccia utente principale.
    Collegato al controller it.unisa.java_music_playlist_manager.PrimaryViewController
-->

<BorderPane minHeight="600.0" minWidth="900.0" prefWidth="1132.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.java_music_playlist_manager.PrimaryViewController">
   
   <!-- 1. BARRA LATERALE (LEFT) -->
   <left>
      <fx:include fx:id="sidebar" source="views/SidebarView.fxml" />
   </left>
   
   <!-- 2. SEZIONE CENTRALE PRINCIPALE (CENTER) -->
   <center>
      <VBox spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <!-- Intestazione Superiore (Titolo e Azioni contestuali) -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <!-- Titolo Sezione Attiva -->
                  <Label fx:id="viewTitleLabel" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Musica" />
                  
                  <!-- Spaziatore per spingere il bottone a destra -->
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <!-- Bottone d'azione dinamico (Aggiungi brano / Nuova playlist) -->
                  <Button fx:id="actionButton" onAction="#handleActionBtnClick" text="Aggiungi brano" />
               </children>
            </HBox>
            
            <!-- Barra di Controllo Playlist / Ordinamento -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <!-- Pulsante Riproduzione Casuale Completa -->
                  <Button fx:id="shufflePlayButton" onAction="#handleShufflePlayAction" style="-fx-font-weight: bold;" text="Riproduzione casuale" />
                  <Button fx:id="playPlaylistButton" disable="true" onAction="#handlePlayPlaylistAction" style="-fx-font-weight: bold;" text="Riproduci Playlist" />
                  
                  <!-- Spaziatore per spingere gli ordinamenti a destra -->
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <!-- Controlli di Ordinamento e Genere (Sulla destra) -->
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Label text="Ordina per:" />
                        <ComboBox fx:id="sortComboBox" promptText="A - Z" />
                        
                        <HBox fx:id="genreFilterContainer" alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <Label text="Genere:" />
                              <ComboBox fx:id="genreComboBox" promptText="Tutti i generi" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
            </HBox>
            
            <!-- Tabella per l'elenco dei Brani (TableView) -->
            <TableView fx:id="songTableView" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="titleColumn" prefWidth="168.79995423555374" text="Titolo" />
                  <TableColumn fx:id="artistColumn" prefWidth="160.8000030517578" text="Artista" />
                  <TableColumn fx:id="albumColumn" prefWidth="151.99993896484375" text="Album" />
                  <TableColumn fx:id="yearColumn" prefWidth="82.39996337890625" text="Anno" />
                  <TableColumn fx:id="genreColumn" prefWidth="111.2000732421875" text="Genere" />
                  <TableColumn fx:id="durationColumn" prefWidth="95.199951171875" text="Durata" />
                  <TableColumn fx:id="TagColumn" prefWidth="90.4000244140625" text="Tag" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   
   <!-- 3. BARRA DI RIPRODUZIONE IN BASSO (BOTTOM) -->
   <bottom>
      <fx:include fx:id="playerBar" source="views/PlayerBarView.fxml" />
   </bottom>
   
</BorderPane>
